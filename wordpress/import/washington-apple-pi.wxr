<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center"><span style="color:#5040ae;font-size:1.9rem">Aaron Davis: What&#x27;s New From Apple!, September 2023</span></p>
<!-- /wp:paragraph -->

<!-- wp:columns -->
