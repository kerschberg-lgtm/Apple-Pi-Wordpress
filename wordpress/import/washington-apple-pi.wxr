<item>
<title>Contact Us</title>
<link>https://www.theapplepi.org/contact-us/</link>
<pubDate>Tue, 22 Sep 2026 12:00:00 -0400</pubDate>
<dc:creator><![CDATA[pi-editor]]></dc:creator>
<guid isPermaLink="false">https://www.theapplepi.org/contact-us.html</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:columns -->
<div class="wp-block-columns">
<!-- wp:column {"width":"50%"} -->
<div class="wp-block-column" style="flex-basis:50%"><!-- wp:html -->
<form class="wap-contact-form" action="#" method="post" onsubmit="return false;">
<h2>How might we assist?</h2>
<p class="wap-required-note">* Indicates required field</p>
<label>Name *</label>
<div class="wap-name-row">
<input type="text" name="first" placeholder="First" aria-label="First">
<input type="text" name="last" placeholder="Last" aria-label="Last">
</div>
<label>Pi Member? *</label>
<label class="wap-choice"><input type="checkbox"> Check, if currently a Pi Member</label>
<label>Here&#x27;s my email address: *</label>
<input type="text" name="email">
<label>My request, question, or comment: *</label>
<textarea name="message" rows="5"></textarea>
<label>My computing devices include (optional): *</label>
<label class="wap-choice"><input type="checkbox"> Mac</label>
<label class="wap-choice"><input type="checkbox"> PC</label>
<label class="wap-choice"><input type="checkbox"> iPhone (or other mobile phone)</label>
<label class="wap-choice"><input type="checkbox"> iPad (or other tablet)</label>
<label class="wap-choice"><input type="checkbox"> HP Calculator (or abacus)</label>
<label>Where do you live? (optional) *</label>
<label class="wap-choice"><input type="radio" name="Where do you live? (optional) *"> In the DC Metro area</label>
<label class="wap-choice"><input type="radio" name="Where do you live? (optional) *"> Outside the DC Metro area</label>
<button type="button">Submit</button>
</form>
<!-- /wp:html --></div>
<!-- /wp:column -->

<!-- wp:column {"width":"50%"} -->
<div class="wp-block-column" style="flex-basis:50%"><!-- wp:image {"sizeSlug":"large","linkDestination":"custom"} -->
<figure class="wp-block-image alignright size-large"><img src="https://www.theapplepi.org/uploads/1/4/5/6/145684944/editor/pi-circular-logo-with-new-website.png?1741716080" alt="Picture"/></figure>
<!-- /wp:image --></div>
<!-- /wp:column -->
</div>
<!-- /wp:columns -->]]></content:encoded>
