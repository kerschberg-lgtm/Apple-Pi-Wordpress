<pubDate>Tue, 22 Sep 2026 12:00:00 -0400</pubDate>
<dc:creator><![CDATA[pi-editor]]></dc:creator>
<guid isPermaLink="false">https://www.theapplepi.org/using-archives.html</guid>
<description></description>
<content:encoded><![CDATA[<!-- wp:paragraph {"align":"center"} -->
<p class="has-text-align-center"><span style="color:#f00707">​Using Archives</span></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><span style="color:#da4444">Historical records are located at the former website: wap.org.  The records can be found under 2 tabs:  Events and Journal.  The journal is currently inactive.</span></p>
